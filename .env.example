# Секреты только здесь. Файл .env в репозиторий не попадает.

# Адрес Postgres. На бою — управляемый инстанс, на разработке — свой.
DATABASE_URL=postgres://tdl:tdl@127.0.0.1:55432/tdl

# Порт процесса. Один процесс: клиент, API, сокет.
PORT=3000

# Хост прослушивания. В песочнице и на VDS — 0.0.0.0.
HOST=0.0.0.0

# Секрет сессий. На бою — свой, длинный, вне репозитория.
SESSION_SECRET=dev-only-secret-change-me

# Закрытая регистрация: 0 или 1. Мировые процессы флаг не читают.
REGISTRATION_OPEN=1

# Мир по умолчанию: имя и зерно.
WORLD_NAME=Первый мир
WORLD_SEED=1541

# Режим: development или production.
NODE_ENV=development
