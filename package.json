{
  "name": "ashfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Эшфолл — MVP мобильной SLG (RoK / GoT: Conquest-like): королевства, марши, KvK",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm -w @ashfall/server run dev",
    "dev:client": "npm -w @ashfall/client run dev",
    "build": "npm -w @ashfall/client run build",
    "start": "npm -w @ashfall/server run start",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:kvk": "node scripts/kvk-smoke.mjs",
    "smoke:ui": "node --import tsx --import ./scripts/css-register.mjs scripts/ui-smoke.ts",
    "typecheck": "tsc -p packages/rules && tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client",
    "shots": "node scripts/shot.mjs",
    "montage": "node scripts/montage.mjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "jsdom": "^24.1.3",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
