# Параллельный мир: тот же код, свой мир, вход только служебным логинам.
# Копия для работы: cp .env.parallel.example .env.parallel
# Общее берётся из .env (DATABASE_URL, SESSION_SECRET, ADMIN_TOKEN).

WORLD_ID=dev-1
WORLD_NAME=Параллельный мир
PORT=3100
WORLD_SIZE=120

# Вход только по списку ниже: игроки в этот мир не попадут ни входом, ни регистрацией.
ACCESS_MODE=admins
# Свой логин: регистрируйтесь в параллельном мире им же.
ADMIN_LOGINS=garry
